{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://operaciones.uner.gy/api/$1"
    },
    {
      "source": "/monitoreo/(.*)",
      "destination": "https://operaciones.uner.gy/monitoreo/$1"
    },
    {
      "source": "/monitoreo",
      "destination": "https://operaciones.uner.gy/monitoreo"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://operaciones.uner.gy/static/$1"
    },
    {
      "source": "/((?!api/|monitoreo|static/).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}
