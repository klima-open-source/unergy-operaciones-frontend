{
  "name": "app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --cache --write",
    "format:check": "prettier . --cache --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "cf:dev": "wrangler dev",
    "cf:deploy": "nuxt build && wrangler deploy"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
