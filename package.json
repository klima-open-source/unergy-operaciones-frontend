    "@nuxt/eslint": "1.17.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@primevue/themes": "^4.0.5",
    "@unovis/vue": "^1.6.7",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "maplibre-gl": "^5.24.0",
    "nuxt": "^4.5.2",
    "pdfjs-dist": "^6.0.227",
    "primevue": "^4.0.5",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "2.8.2",
    "tailwind-merge": "^3.6.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.3",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
