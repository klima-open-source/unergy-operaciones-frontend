# Nuxt maps every variable to a `runtimeConfig` key: NUXT_PUBLIC_API_BASE_URL
# overrides `runtimeConfig.public.apiBaseUrl`, NUXT_AUTH_COOKIE_SECURE overrides
# `runtimeConfig.authCookieSecure`, and so on. See nuxt.config.ts.

# ─── App ──────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Only when auth lives on its own host; empty falls back to the API base URL.
NUXT_AUTH_API_BASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_AUTH_ENABLED=true

# Unergy Auth (authentication-system). Encenderlo solo si el backend tiene
# GRPC_HOST configurado: si no, rechaza esos tokens y cada petición da 401.
NUXT_PUBLIC_UNERGY_AUTH_ENABLED=false
NUXT_UNERGY_AUTH_URL=https://auth.unergy.io

# originabot (TSF), para importar proyectos con el token de Unergy Auth. Tiene
# que ser el del mismo entorno que el Auth: devauth -> devoriginabot.
NUXT_ORIGINABOT_URL=https://originabot.uner.gy
# La app de TSF (unergy-platform), para enlazar el PDF del contrato de arriendo. Dev: https://devtsf.uner.gy
NUXT_TSF_URL=https://tsf.unergy.io

# Auth methods — enable the strategies your backend supports
NUXT_PUBLIC_AUTH_PASSWORD_ENABLED=true
NUXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Auth cookies (server-only) ───────────────────────────────────────────────
NUXT_AUTH_COOKIE_DOMAIN=
NUXT_AUTH_COOKIE_SECURE=false
NUXT_AUTH_COOKIE_MAX_AGE=604800
NUXT_AUTH_COOKIE_SAMESITE=lax

# ─── MIGRACIÓN: proxies de Nitro (server-only) ────────────────────────────────
# A dónde reenvía Nitro `/api/v1/**` y `/monitoreo/**`. Sustituye al proxy de
# Vite del legacy y a los rewrites de vercel.json.
#
# **Esta variable decide contra qué backend trabajás, y se lee AL ARRANCAR**:
# cambiarla exige reiniciar `npm run dev`. Los tres destinos posibles:
#
#   http://localhost:8000          Tu backend local (docker compose en el repo
#                                  del backend). Usa la base que diga SU .env.
#                                  Podés romper lo que quieras.
#
#   https://operaciones.unergy.io  PRODUCCION. Datos reales. Lo que confirmes,
#                                  crees o borres desde localhost TOCA
#                                  PRODUCCION -- no hay ninguna red de
#                                  seguridad por estar en local.
#
#   https://operaciones.uner.gy    Un despliegue VIEJO, con la copia de la base
#                                  en Railway. Sus datos NO son los de
#                                  produccion y llevan meses de diferencia
#                                  (2026-09-15: tres proyectos con el codigo TSF
#                                  mal guardado que en produccion estan bien, y
#                                  6.444 fallas contra 561 reales). Apuntar aca
#                                  sin saberlo lleva a diagnosticar problemas
#                                  que no existen.
NUXT_API_PROXY_TARGET=http://localhost:8000

# API de EVO (precio de bolsa y clima). El token se inyecta server-side y NO
# debe llegar nunca al bundle del cliente.
NUXT_EVO_API_URL=http://localhost:18800
NUXT_EVO_API_TOKEN=
