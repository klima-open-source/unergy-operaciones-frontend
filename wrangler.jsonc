{
  // Leído en dos momentos distintos, y por eso trae `main`/`assets`:
  //
  //  1. En build (`nuxt build`), el preset `cloudflare-module` de Nitro lo lee
  //     desde la raíz, fusiona `vars` en `.output/server/wrangler.json` y
  //     recalcula `main`/`assets` con las rutas relativas a esa carpeta —
  //     ver `nuxt.config.ts`. Los de aquí abajo quedan ignorados en ese paso
  //     (Nitro avisa "overridden and will be ignored" en el log, es normal).
  //  2. En el deploy de Cloudflare (Workers Builds), el comando configurado en
  //     el dashboard — "npx wrangler versions upload" — corre desde la raíz
  //     del repo, **después** del build, y sin `--cwd .output`. Sin `main`/
  //     `assets` acá, ese paso falla con "Missing entry-point" aunque el
  //     `.output/server/wrangler.json` generado esté perfecto: wrangler nunca
  //     lo lee, porque no es donde busca config desde la raíz.
  //
  // `vars` es lo que hace que estas variables aparezcan en el dashboard de
  // Cloudflare (Settings → Variables and Secrets) después de un deploy: sin
  // declararlas en algún lado, un Worker desplegado no muestra nada. Son las
  // mismas claves de `.env.example`, sin las que son secreto real —
  // `NUXT_EVO_API_TOKEN` se setea con `wrangler secret put`, nunca en texto
  // plano acá, porque este archivo se commitea.
  //
  // Los valores de abajo son defaults seguros para arrancar; edítalos aquí (o
  // sobreescríbelos desde el dashboard) para producción.
  "name": "unergy-operaciones",
  "compatibility_date": "2026-08-28",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },

  "vars": {
    "NUXT_PUBLIC_API_BASE_URL": "",
    "NUXT_PUBLIC_AUTH_ENABLED": "true",
    "NUXT_PUBLIC_AUTH_PASSWORD_ENABLED": "true",
    "NUXT_PUBLIC_AUTH_GOOGLE_ENABLED": "false",
    "NUXT_PUBLIC_GOOGLE_CLIENT_ID": "",

    "NUXT_AUTH_API_BASE_URL": "",
    "NUXT_AUTH_COOKIE_DOMAIN": "",
    "NUXT_AUTH_COOKIE_SECURE": "true",
    "NUXT_AUTH_COOKIE_SAMESITE": "lax",
    "NUXT_AUTH_COOKIE_MAX_AGE": "604800",

    "NUXT_API_PROXY_TARGET": "https://operaciones.uner.gy",
    "NUXT_EVO_API_URL": "",
  },

  // Workers Logs/Traces — separado del `vars` de arriba: esto no llega a la
  // app, es telemetría que Cloudflare recolecta del Worker en sí.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
